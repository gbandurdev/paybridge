{
    "name": "paybridge/paybridge",
    "description": "Framework-agnostic PHP payment gateway abstraction with built-in resilience (idempotency, retries, circuit breaker) and pluggable provider drivers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["payments", "stripe", "paypal", "gateway", "psr-18", "idempotency"],
    "require": {
        "php": "^8.3",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0",
        "psr/log": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "suggest": {
        "ext-pdo": "Required for the PDO-backed stores (Store/Pdo/*).",
        "ext-pdo_sqlite": "Required if using the PDO store with a sqlite: DSN.",
        "ext-pdo_pgsql": "Required if using the PDO store with a pgsql: DSN.",
        "ext-pdo_mysql": "Required if using the PDO store with a mysql: DSN.",
        "ext-redis": "Required for the Redis-backed stores (Store/Redis/*)."
    },
    "autoload": {
        "psr-4": {
            "PayBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
